# ============================================================
# Weather Station Log System – Variables de entorno
# Copiar como .env y ajustar según el entorno de despliegue
# ============================================================

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# PostgreSQL
POSTGRES_DB=weather_db
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_pass

# Productor
PUBLISH_INTERVAL=3        # Segundos entre publicaciones
STATIONS_COUNT=5          # Número de estaciones simuladas

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=grafana123
